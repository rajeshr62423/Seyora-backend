# env
NODE_ENV=development
PORT=4000

# DB
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

#auth
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - the frontend's origin
CORS_ORIGIN="http://localhost:3000"

# Razorpay
RAZOR_KEY_ID="your-razorpay-key-id"
RAZOR_SECRET_KEY="your-razorpay-secret-key"

//TEST PAYMENT RAZOR
RAZOR_KEY_ID="key_id"
RAZOR_SECRET_KEY="secret_key"

# Frontend origin invitation emails link back to
# (${APP_URL}/invitations/accept?token=...)
APP_URL="http://localhost:3000"

# Invitations
INVITATION_EXPIRES_IN_HOURS=24

# Password reset — optional, defaults to 1 hour if unset
PASSWORD_RESET_EXPIRES_IN_HOURS=1

# Mail (Brevo SMTP)
MAIL_FROM_NAME="Seyora"
SENDER_MAIL="your-verified-sender@example.com"

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587

BREVO_SMTP_LOGIN="your-brevo-smtp-login"
BREVO_SMTP_API_KEY="your-brevo-smtp-api-key"